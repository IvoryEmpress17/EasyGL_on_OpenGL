        "major",
        "主版本号。"
      ],
      [
        "minor",
        "次版本号。"
      ]
    ],
    "ret": "无",
    "remarks": [
      "必须在 <a href='initgraph.htm'>initgraph</a> <b>之前</b>调用；上下文创建后调用无效。"
    ]
  },
  {
    "name": "setorigin",
    "cat": "绘图设备相关函数",
    "sig": [
      "void setorigin(double x, double y);"
    ],
    "brief": "设置坐标原点。",
    "params": [
      [
        "x",
        "原点的 x 坐标（逻辑坐标）。"
      ],
      [
        "y",
        "原点的 y 坐标（逻辑坐标）。"
      ]
    ],
    "ret": "无",
    "remarks": [
      "参数类型为 <b>double</b>，支持小数（EasyX 为 int）。",
      "若启用 <a href='fixhighdpi.htm'>fixhighdpi</a>，偏移量同样会乘以高 DPI 系数。<a href='getorigin.htm'>getorigin</a> 读回的仍是<b>设置值本身</b>（逻辑单位）。"
    ]
  },
