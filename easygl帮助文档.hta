  RESIZE="yes">
<style>
html,body{margin:0;padding:0;height:100%;overflow:hidden;
  font-family:"Tahoma","Microsoft YaHei",SimSun,sans-serif;font-size:13px;}
/* 顶部标签栏 */
#tabs{position:absolute;top:0;left:0;right:0;height:30px;
  background:#f0f0f0;border-bottom:1px solid #a0a0a0;overflow:hidden;}
.tab{float:left;padding:0 16px;line-height:29px;cursor:pointer;
  border-right:1px solid #d0d0d0;color:#333;height:29px;}
.tab:hover{background:#e0e8f0;}
.tab.on{background:#fff;font-weight:bold;height:30px;}
/* 主体：绝对定位两栏（不使用 flex / calc） */
#main{position:absolute;top:31px;left:0;right:0;bottom:0;}
#side{position:absolute;top:0;bottom:0;left:0;width:290px;
  background:#f7f7f7;border-right:1px solid #a0a0a0;overflow:auto;padding:6px 0;}
#split{position:absolute;top:0;bottom:0;left:290px;width:4px;
  cursor:col-resize;background:#d8d8d8;}
#content{position:absolute;top:0;bottom:0;left:294px;right:0;
  overflow:auto;padding:0;background:#fff;}
/* 目录树 */
.tree{padding-left:0;margin:0;list-style:none;}
.cat{cursor:pointer;padding:3px 8px 3px 6px;white-space:nowrap;color:#000;}
.cat:hover{background:#e0e8f0;}
.cat b{font-weight:bold;}
ul.sub{list-style:none;margin:0;padding-left:16px;}
li.fun{cursor:pointer;padding:2px 8px 2px 6px;white-space:nowrap;color:#1a3d8f;}
li.fun:hover{background:#dbe7f7;text-decoration:underline;}
li.fun.sel{background:#c8dcfa;font-weight:bold;}
.tw{display:inline-block;width:12px;color:#666;font-family:"Courier New",monospace;}
/* 目录图标（CHM 风格）。16x16 原尺寸，不要缩放——缩放后 GIF 会糊成一团；
 * vertical-align 用 middle 让图标和文字的视觉中线对齐，比 -2px 稳。 */
img.ic{width:16px;height:16px;vertical-align:middle;margin-right:5px;
  border:0;image-rendering:auto;}
.cat img.ic{margin-right:4px;margin-left:2px;}
/* 索引/搜索列表 */
.ilist{padding:2px 0;}
.irow{padding:2px 10px;cursor:pointer;white-space:nowrap;}
.irow:hover{background:#dbe7f7;text-decoration:underline;}
.irow em{font-style:normal;color:#666;font-size:11px;margin-left:6px;}
.irow.sel{background:#c8dcfa;}
#sbox{padding:6px;}
#q{width:94%;padding:3px 4px;font-size:13px;border:1px solid #aaa;}
#hint{padding:4px 10px;color:#666;font-size:12px;}
.hl{background:#ffe08a;}
/* 内容 */
.page{padding:14px 26px 60px;max-width:900px;line-height:1.75;}
.page h1{font-size:20px;margin:0 0 6px;color:#10307a;border-bottom:2px solid #d0d8e8;
  padding-bottom:6px;}
.page h2{font-size:15px;margin:18px 0 6px;color:#10307a;border-bottom:1px solid #e0e6f0;
  padding-bottom:3px;}
.page h3{font-size:13px;margin:10px 0 3px;color:#000;font-family:"Courier New",monospace;}
.page p{margin:5px 0;}
.page .brief{color:#333;margin-bottom:10px;}
/* 示例页顶部的编码标注 */
.enc{margin:0 0 10px;padding:6px 10px;background:#fff8e6;border-left:4px solid #e0a800;
    color:#6b4c00;font-size:13px;}
.enc b{color:#8a5d00;}
pre.code{background:#f6f8fa;border:1px solid #dde3ea;border-left:3px solid #4a86d8;
  padding:8px 12px;overflow:auto;font-family:"Consolas","Courier New",monospace;
  font-size:12.5px;line-height:1.55;margin:8px 0;}
table.t{border-collapse:collapse;margin:8px 0;font-size:12.5px;}
table.t th,table.t td{border:1px solid #c8d0dc;padding:4px 10px;text-align:left;}
table.t th{background:#eaf0f8;}
table.t tr.head td{background:#f4f8fd;}
.tag{display:inline-block;background:#eef4ff;border:1px solid #b8ccec;color:#2a4d8f;
  font-size:11px;padding:1px 6px;border-radius:3px;margin-left:8px;vertical-align:middle;}
.warn{background:#fff8e6;border-left:3px solid #e0a800;padding:7px 12px;margin:8px 0;}
.empty{padding:30px;color:#888;text-align:center;}
/* 目录右键菜单。z-index 要盖住侧栏，侧栏是 overflow:auto 的，
 * 所以菜单挂在 body 下而不是侧栏里，否则会被裁掉。 */
#menu{position:absolute;z-index:99;display:none;background:#fff;
  border:1px solid #909090;padding:2px 0;min-width:120px;font-size:13px;
  box-shadow:2px 2px 6px rgba(0,0,0,.28);}
#menu div.mi{padding:4px 20px 4px 22px;cursor:pointer;white-space:nowrap;
  color:#000;}
#menu div.mi:hover{background:#c8dcfa;}
#menu div.ms{height:1px;background:#dcdcdc;margin:3px 0;}
/* 代码块右上角的复制按钮。默认刻意做淡：它是悬停才出现的辅助控件，
 * 比正文弱一档才不抢视线；鼠标移上去才变成正常的强调色。 */
#cpbtn{position:absolute;z-index:98;display:none;cursor:pointer;
  font-size:11px;line-height:16px;padding:1px 7px;color:#a8b0bc;
  background:#fff;border:1px solid #e6ebf2;border-radius:3px;
  font-family:"Tahoma","Microsoft YaHei",SimSun,sans-serif;}
#cpbtn:hover{color:#2a4d8f;border-color:#b8ccec;background:#f2f7ff;}
#cpbtn.done{color:#3a8a3a;border-color:#bfe0bf;background:#f2fbf2;}
/* 代码语法着色。配色取自常见 IDE 的浅色主题：关键字最扎眼，
 * 注释最弱——注释是给人扫一眼就跳过的，不能和代码抢注意力。 */
.gxk{color:#0033b3;font-weight:bold;}   /* 关键字   */
.gxt{color:#1e7a8a;}                    /* 类型     */
.gxs{color:#0b7a2e;}                    /* 字符串   */
.gxc{color:#6a737d;font-style:italic;}  /* 注释     */
.gxp{color:#8b3a8b;}                    /* 预处理   */
.gxn{color:#b4520a;}                    /* 数字/字面量 */
</style>
