      "/* 不带后缀：按指针类型自动选上面两者之一 */",
      "void setfont(const LOGFONTA* font);",
      "void setfont(const LOGFONTW* font);",
      "/* 写 LOGFONT 即可：库里 #define LOGFONT LOGFONTA */",
      "void setfont(const LOGFONT* font);"
