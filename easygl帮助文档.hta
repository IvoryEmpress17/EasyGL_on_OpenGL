      [
        "S",
        "饱和度 0~1。"
      ],
      [
        "L",
        "亮度 0~1。"
      ]
    ],
    "ret": "返回 RGB 颜色。",
    "remarks": []
  },
  {
    "name": "HSVtoHSL",
    "cat": "颜色模型",
    "sig": [
      "void HSVtoHSL(float H, float S, float V,",
      "               float* pS, float* pL);"
    ],
    "brief": "将 HSV 颜色转换为 HSL 颜色。",
    "params": [
      [
        "H",
        "色相 0~360。两个模型共用同一色相，本函数不使用也不修改它。"
      ],
      [
        "S",
        "输入的 HSV 饱和度，0~1。"
      ],
      [
        "V",
        "输入的 HSV 明度，0~1。"
      ],
      [
        "pS",
        "输出：转换后的 HSL 饱和度，0~1。可为 NULL。"
      ],
      [
        "pL",
        "输出：转换后的 HSL 亮度，0~1。可为 NULL。"
      ]
    ],
    "ret": "无",
    "remarks": [
      "与 <a href='HSLtoHSV.htm'>HSLtoHSV</a> 完全对称，参数方向同样是「S、V 按值进，pS、pL 由指针出」。",
      "两个输出指针都可以传 NULL。"
    ]
  },
