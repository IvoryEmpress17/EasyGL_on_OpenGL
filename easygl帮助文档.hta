  {
    "name": "setbkmode",
    "cat": "图形颜色及样式设置相关函数",
    "sig": [
      "void setbkmode(int mode);"
    ],
    "brief": "设置背景混合模式。",
    "params": [
      [
        "mode",
        "OPAQUE（不透明）或 TRANSPARENT（透明）。"
      ]
