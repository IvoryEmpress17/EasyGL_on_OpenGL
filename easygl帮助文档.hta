        "接收输入内容的缓冲区。"
      ],
      [
        "nMaxCount",
        "缓冲区最大字符数。"
      ],
      [
        "pPrompt",
        "提示文字。"
      ],
      [
        "pTitle",
        "标题，默认为 InputBox。"
