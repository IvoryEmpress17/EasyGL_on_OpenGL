  {
    "name": "getmessage",
    "cat": "消息处理相关函数",
    "sig": [
      "ExMessage getmessage();",
      "ExMessage getmessage(BYTE filter);",
      "ExMessage getmessage(ExMessage* msg);",
      "ExMessage getmessage(ExMessage* msg, BYTE filter);",
      "MOUSEMSG  getmessage(MOUSEMSG* msg, BYTE filter);"
